@book{lavennedelamontoiseOAIPMHPMHLheure2020,
  type = {Mémoire d'étude diplôme de conservateur des bibliothèques},
  title = {OAI-PMH à PMH à « l'heure du web sémantique »: bilans et perspectives},
  shorttitle = {OAI-PMH à PMH à « l'heure du web sémantique »},
  author = {family=Lavenne de la Montoise, given=Vincent, prefix=de, useprefix=false},
  date = {2020},
  publisher = {École nationale supérieure des sciences de l'information et des bibliothèques},
  location = {Villeurbanne, Rhône, France},
  abstract = {À l’approche du vingtième anniversaire du protocole OAI PMH, et dans un environnement web qui a subi de profondes évolutions (technologiques et d’usages), quelle est l’actualité de l’échange de données ? Comment se sont construits les usages des professionnelles en la matière ? Sont ils adaptés aux défis actuels ? Ce travail se propose d’analyser l’exposition et l’échange de données sous un angle historique, avant d’essayer de comprendre les enjeux actuels qui détermineront quelle(s) solution(s) techniques choisir.~While we are nearing the twentieth birthday of the OAI PMH protocol, and in a web environment which went through massive changes, both in technology and in usage, what is the actuality of data exchange ? How did the community build its practices? Are they still relevant in the light of today’s challenges? This work analyses data exposition and exchange from a historical standpoint, before trying to understand the current challenges which will determine what technical solution(s) should be used.},
  langid = {french},
  pagetotal = {116},
  keywords = {Bibliothèques numériques,Édition en libre accès,Métadonnées,themeNumerisation,Web 2.0,Web sémantique},
  file = {/home/fanny-suszko/snap/zotero-snap/common/Zotero/storage/SMVP685Y/69909-oai-pmh-a-l-heure-du-web-semantique.pdf;/home/fanny-suszko/snap/zotero-snap/common/Zotero/storage/D63WB7ZZ/SHW.html}
}

