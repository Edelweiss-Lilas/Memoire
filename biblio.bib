@article{condamineEntreHeritageFonctionnel2014,
  title = {Entre héritage fonctionnel et renouveau décoratif, les pompes funèbres de Michel-Ange Challe dans la seconde moitié du XVIIIe siècle},
  author = {Condamine, Romain},
  date = {2014},
  journaltitle = {Europa Moderna. Revue d'histoire et d'iconologie},
  shortjournal = {emod},
  volume = {4},
  number = {1},
  pages = {58--85},
  issn = {2107-6642},
  doi = {10.3406/emod.2014.864},
  url = {https://www.persee.fr/doc/emod_2107-6642_2014_num_4_1_864},
  urldate = {2023-09-22},
  abstract = {Durant l’exercice de Michel-Ange Challe (1716-1778) aux Menus Plaisirs entre 1765 et 1778, les grandes pompes funèbres commandées par la Couronne à Notre-Dame et Saint-Denis, tout en répondant à un cérémonial fixé par plusieurs décennies de tradition, connaissent des transformations notables sur le plan décoratif. Tout en préservant la charge symbolique du décor de ces cérémonies, événements politiques et religieux de premier plan, les travaux du dessinateur de la Chambre et du Cabinet du roi, à l’heure de la diffusion du «goût à la grecque » sont les témoins d’une esthétique contemporaine en mutation.           ,              Between 1765 and 1778, Michel-Ange Challe (1716-1778), who hold the position of dessinateur de la Chambre et du Cabinet du roi was the surveyor of the Menus Plaisirs department. He was thus in charge of several temporary decorations set up in Notre-Dame and Saint-Denis for princely and royal funeral services. While observing the state ceremonial established by decades of traditions and preserving the symbolic charge of these highly political and religious moments, these ephemeral architectures express the significant transformations of the contemporary taste during the spread of the “goût à la grecque”.},
  langid = {french},
  keywords = {Articles}
}

